# Generated by Cargo
# will have compiled files and executables
/target/

# Standalone tutorial crates create local build directories when Cargo is run directly.
/tutorial/*/target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# Generated protobuf Rust files
src/proto/*.rs
!src/proto/mod.rs

# Added by cargo
#
# already existing elements were commented out

/target
#Cargo.lock
/.idea/

# docker container data
/volumes/

# Code coverage report
/code_coverage/

# Python bytecode and interpreter caches
__pycache__/
*.py[cod]

# Generated rustdoc output; keep hand-written guides under version control
/doc/*
!/doc/guide/
!/doc/guide/**
